{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zhongduan-terminal-cloud",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-27",
  "vars": {
    "CLOUD_TELEMETRY_MODE": "workers-logs-v1",
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TERMINAL_SESSIONS",
        "class_name": "TerminalSessionDO",
      },
    ],
  },
  "exports": {
    "TerminalSessionDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "zhongduan-terminal-snapshots",
      "preview_bucket_name": "zhongduan-terminal-snapshots-preview",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
}
