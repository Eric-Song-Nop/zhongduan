{
  "name": "@zhongduan/host-daemon",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "zhongduan-host": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../scripts/prepare-wterm.mjs && vp pack && node ../../scripts/package-host-assets.mjs",
    "check": "node ../../scripts/prepare-wterm.mjs && vp check",
    "test": "node ../../scripts/prepare-wterm.mjs && vp test --run"
  },
  "dependencies": {
    "@wterm/ghostty": "workspace:*",
    "@zhongduan/protocol": "workspace:*",
    "@zhongduan/telemetry": "workspace:*",
    "node-pty": "1.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
